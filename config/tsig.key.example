################################################################################
# /etc/named/keys/tsig.key — TSIG key material (hmac-sha384 mandatory)
#
# THIS IS A TEMPLATE. Generate a real key with the included helper script and
# install identically on every server that shares this trust relationship.
#
#     ./scripts/new-tsig-key.sh -n zone-transfer-key -a hmac-sha384
#
# The generated 'secret' below is a PLACEHOLDER — never deploy it. The key
# value must be identical on the primary and every secondary that uses it.
#
# File permissions
#     install -d -o root -g named -m 0750 /etc/named/keys
#     install -o root -g named -m 0640 tsig.key /etc/named/keys/tsig.key
#
# Algorithm rationale
#     hmac-sha384 is the mandatory digest per the deployment requirements.
#     hmac-sha256, hmac-sha512 are also acceptable per RFC 8945 but should
#     only be used when SHA-384 is unavailable. hmac-md5 is forbidden.
################################################################################

key "zone-transfer-key" {
    algorithm hmac-sha384;

    # PLACEHOLDER — regenerate with new-tsig-key.sh before deployment.
    secret "REPLACE_ME_BASE64_SECRET_FROM_NEW_TSIG_KEY_SCRIPT_GENERATOR_PLACEHOLDER==";
};
