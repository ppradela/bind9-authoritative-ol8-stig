; ============================================================================
; /var/named/db.192.0.2
;
; Reverse zone — 2.0.192.in-addr.arpa  (covers 192.0.2.0/24, a full 8-bit
; boundary; delegation on full octet boundaries supported).
;
; PTR records match the corresponding A records in db.example.com:
;     192.0.2.20  ← ns1.example.com
;     192.0.2.21  ← ns2.example.com
;     192.0.2.30  ← www.example.com / example.com apex
;     192.0.2.31  ← mail.example.com
;     192.0.2.32  ← ldap.example.com
;     192.0.2.33  ← ntp.example.com
; ============================================================================

$TTL 3600
$ORIGIN 2.0.192.in-addr.arpa.

@   IN  SOA   ns1.example.com. hostmaster.example.com. (
              2026031101    ; serial    — bump on every edit
              3600          ; refresh
              900           ; retry
              5184000       ; expire    — 60 d
              3600          ; minimum
              )

@   IN  NS    ns1.example.com.
@   IN  NS    ns2.example.com.

20  IN  PTR   ns1.example.com.
21  IN  PTR   ns2.example.com.
30  IN  PTR   www.example.com.
31  IN  PTR   mail.example.com.
32  IN  PTR   ldap.example.com.
33  IN  PTR   ntp.example.com.

; ============================================================================
; END
; ============================================================================
